<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pembayaran" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="P_TGL_AWAL" class="java.lang.String" isForPrompting="false"/>
	<parameter name="P_TGL_AKHIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
  b.id_pembayaran,
  b.tanggal_bayar,
  ps.nim,
  ps.nama AS nama_peserta,
  kls.nama_kelas,
  k.nama_kursus,
  b.nominal,
  b.metode,
  b.status,
  b.id_pendaftaran
FROM pembayaran b
JOIN pendaftaran p ON p.id_pendaftaran = b.id_pendaftaran
JOIN peserta ps    ON ps.id_peserta    = p.id_peserta
JOIN kelas kls     ON kls.id_kelas     = p.id_kelas
JOIN kursus k      ON k.id_kursus      = kls.id_kursus
WHERE DATE(b.tanggal_bayar) BETWEEN $P{P_TGL_AWAL} AND $P{P_TGL_AKHIR}
ORDER BY b.id_pembayaran ASC]]>
	</queryString>
	<field name="id_pembayaran" class="java.lang.Integer"/>
	<field name="tanggal_bayar" class="java.lang.Object"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_peserta" class="java.lang.String"/>
	<field name="nama_kelas" class="java.lang.String"/>
	<field name="nama_kursus" class="java.lang.String"/>
	<field name="nominal" class="java.lang.Object"/>
	<field name="metode" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="id_pendaftaran" class="java.lang.Integer"/>
	<title>
		<band height="76">
			<staticText>
				<reportElement x="0" y="5" width="802" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
				<text><![CDATA[LAPORAN PEMBAYARAN KURSUS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="33" width="802" height="18"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
				<text><![CDATA[SIKURSUS Desktop - Pemrograman Berorientasi Objek]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="51" width="802" height="18"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9"/></textElement>
				<textFieldExpression><![CDATA["Periode: " + $P{P_TGL_AWAL} + " s/d " + $P{P_TGL_AKHIR}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="24">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="35" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[ID]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="35" y="0" width="70" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Tanggal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="105" y="0" width="70" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[NIM]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="175" y="0" width="160" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Peserta]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="335" y="0" width="65" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Kelas]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="400" y="0" width="175" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Kursus]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="575" y="0" width="75" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Nominal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="650" y="0" width="60" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Metode]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="710" y="0" width="52" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="762" y="0" width="40" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[ID Daftar]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="0" width="35" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{id_pembayaran}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="35" y="0" width="70" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[String.valueOf($F{tanggal_bayar})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="105" y="0" width="70" height="22"/>
				<box leftPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="175" y="0" width="160" height="22"/>
				<box leftPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="335" y="0" width="65" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="400" y="0" width="175" height="22"/>
				<box leftPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" pattern="#,##0">
				<reportElement x="575" y="0" width="75" height="22"/>
				<box rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nominal}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="650" y="0" width="60" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{metode}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="710" y="0" width="52" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="762" y="0" width="40" height="22"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{id_pendaftaran}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="24">
			<textField>
				<reportElement x="0" y="4" width="300" height="18"/>
				<textElement verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA["Dicetak: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
