				<text><![CDATA[NIM]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="110" y="0" width="140" height="24" forecolor="#FFFFFF" backcolor="#166534"/>
				<box><pen lineWidth="0.5"/></box>
