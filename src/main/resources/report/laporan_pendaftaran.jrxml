				<textFieldExpression><![CDATA[$F{status_pendaftaran}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="133" y="0" width="55" height="22"/>
				<box leftPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="188" y="0" width="104" height="22"/>
				<box leftPadding="3"><pen lineWidth="0.5"/></box>
