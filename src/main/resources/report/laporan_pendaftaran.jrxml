<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pendaftaran" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="P_ID_PENDAFTARAN" class="java.lang.Integer" isForPrompting="true"/>
	<queryString>
		<![CDATA[SELECT
  p.id_pendaftaran,
  p.tanggal_daftar,
  p.status AS status_pendaftaran,
  ps.nim,
  ps.nama AS nama_peserta,
  ps.prodi,
  ps.no_hp,
  kls.nama_kelas,
  k.kode_kursus,
  k.nama_kursus,
  k.level,
  k.biaya,
  i.nama AS nama_instruktur
FROM pendaftaran p
JOIN peserta ps   ON ps.id_peserta   = p.id_peserta
JOIN kelas kls    ON kls.id_kelas    = p.id_kelas
JOIN kursus k     ON k.id_kursus     = kls.id_kursus
JOIN instruktur i ON i.id_instruktur = kls.id_instruktur
WHERE ($P{P_ID_PENDAFTARAN} IS NULL
       OR p.id_pendaftaran = $P{P_ID_PENDAFTARAN})
ORDER BY p.id_pendaftaran ASC]]>
	</queryString>
	<field name="id_pendaftaran" class="java.lang.Integer"/>
	<field name="tanggal_daftar" class="java.lang.Object"/>
	<field name="status_pendaftaran" class="java.lang.String"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_peserta" class="java.lang.String"/>
	<field name="prodi" class="java.lang.String"/>
	<field name="no_hp" class="java.lang.String"/>
	<field name="nama_kelas" class="java.lang.String"/>
	<field name="kode_kursus" class="java.lang.String"/>
	<field name="nama_kursus" class="java.lang.String"/>
	<field name="level" class="java.lang.String"/>
	<field name="biaya" class="java.lang.Object"/>
	<field name="nama_instruktur" class="java.lang.String"/>
